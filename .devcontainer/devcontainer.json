{
  "name": "TP4 injection SQL (PHP + Java, SQLite)",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "installMaven": "true" }
  },
  "postCreateCommand": "cd php && composer install && composer init-db",
  "containerEnv": { "XDEBUG_MODE": "off" },
  "forwardPorts": [8000],
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack", "bmewburn.vscode-intelephense-client"] }
  }
}
